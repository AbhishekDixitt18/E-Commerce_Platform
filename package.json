{
  "name": "ecommerce-cloud-devops",
  "version": "1.0.0",
  "description": "Production-style E-Commerce Product and Order REST API with Cloud Deployment & CI/CD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ scripts/ tests/",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js"
  },
  "keywords": [
    "ecommerce",
    "rest-api",
    "nodejs",
    "express",
    "postgresql",
    "docker",
    "ci-cd",
    "devops"
  ],
  "author": "ALGIONS AI LABS Candidate",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
